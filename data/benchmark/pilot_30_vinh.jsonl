{"id": "P-V-C04", "source_set": "vinh30", "source_id": "C04", "category": "C_multihop_spatial", "subtype": null, "item_role": "trap", "question": "Tỉnh có thành phố Đà Lạt cũ hiện nay có giáp biển không?", "reference_date": "2026-11-19", "gold_answer": {"text": "Có. Tỉnh Lâm Đồng mới bao gồm cả tỉnh Bình Thuận cũ nên có bờ biển (khu vực Phan Thiết, Mũi Né) và cả đặc khu Phú Quý ngoài khơi.", "aliases": ["có", "giáp biển", "Bình Thuận"], "answer_type": "yes_no", "entities": []}, "obsolete_answer": {"text": "Không. Lâm Đồng là tỉnh Tây Nguyên, không giáp biển.", "obsolete_entities": ["không giáp biển", "Tây Nguyên"]}, "evidence": [{"doc_id": "NQ-202-2025-QH15", "article": "1", "clause": "14", "clause_id": "NQ-202-2025-QH15#D1.K14", "citation": "NQ 202/2025/QH15, Điều 1, khoản 14", "in_corpus": true}, {"doc_id": "NQ-1671-2025-UBTVQH15", "article": "1", "clause": "119", "clause_id": "NQ-1671-2025-UBTVQH15#D1.K119", "citation": "NQ 1671/NQ-UBTVQH15, Điều 1, khoản 119", "in_corpus": true}], "gold_clause_ids": ["NQ-202-2025-QH15#D1.K14", "NQ-1671-2025-UBTVQH15#D1.K119"], "source_url": "", "province_new": "Lâm Đồng", "province_is_control": false, "hops": 2, "difficulty": null, "annotator": ["TV3"], "verified": false, "verification_note": "K14 nêu Lâm Đồng giáp Biển Đông; K119 thành lập đặc khu Phú Quý.", "version": "pilot-0.2"}
{"id": "P-V-C05", "source_set": "vinh30", "source_id": "C05", "category": "C_multihop_spatial", "subtype": null, "item_role": "trap", "question": "Tỉnh Quảng Ngãi hiện có chung đường biên giới với những nước nào?", "reference_date": "2026-11-19", "gold_answer": {"text": "Lào và Campuchia, vì tỉnh Kon Tum (giáp Lào và Campuchia) đã hợp nhất vào tỉnh Quảng Ngãi.", "aliases": ["Lào", "Campuchia"], "answer_type": "entity_list", "entities": ["Lào", "Campuchia"]}, "obsolete_answer": {"text": "Không có. Quảng Ngãi là tỉnh duyên hải Nam Trung Bộ, không có biên giới quốc tế.", "obsolete_entities": ["không có biên giới", "duyên hải"]}, "evidence": [{"doc_id": "NQ-202-2025-QH15", "article": "1", "clause": "11", "clause_id": "NQ-202-2025-QH15#D1.K11", "citation": "NQ 202/2025/QH15, Điều 1, khoản 11", "in_corpus": true}], "gold_clause_ids": ["NQ-202-2025-QH15#D1.K11"], "source_url": "", "province_new": "Quảng Ngãi", "province_is_control": false, "hops": 2, "difficulty": null, "annotator": ["TV3"], "verified": false, "verification_note": "Sheet: Cần dò đường biên giới với Campuchia. K11 nêu Quảng Ngãi giáp Lào và Campuchia (giải quyết mục 'cần dò biên giới Campuchia').", "version": "pilot-0.2"}
{"id": "P-V-C06", "source_set": "vinh30", "source_id": "C06", "category": "C_multihop_spatial", "subtype": null, "item_role": "control", "question": "Vịnh Hạ Long hiện thuộc tỉnh nào?", "reference_date": "2026-11-19", "gold_answer": {"text": "Tỉnh Quảng Ninh (tỉnh giữ nguyên, không hợp nhất).", "aliases": ["Quảng Ninh"], "answer_type": "entity", "entities": ["Quảng Ninh"]}, "obsolete_answer": {"text": "", "obsolete_entities": []}, "evidence": [{"doc_id": "NQ-202-2025-QH15", "article": "1", "clause": "24", "clause_id": "NQ-202-2025-QH15#D1.K24", "citation": "NQ 202/2025/QH15, Điều 1, khoản 24", "in_corpus": true}], "gold_clause_ids": ["TODO_VERIFY_CLAUSE"], "source_url": "", "province_new": "Quảng Ninh", "province_is_control": true, "hops": 2, "difficulty": null, "annotator": ["TV3"], "verified": false, "verification_note": "K24 chỉ xác nhận Quảng Ninh không sắp xếp; vị trí Vịnh Hạ Long không có trong kho.", "version": "pilot-0.2"}
{"id": "P-V-C07", "source_set": "vinh30", "source_id": "C07", "category": "C_multihop_spatial", "subtype": null, "item_role": "trap", "question": "Phú Quốc hiện là đơn vị hành chính gì và thuộc tỉnh nào?", "reference_date": "2026-11-19", "gold_answer": {"text": "Đặc khu Phú Quốc, thuộc tỉnh An Giang. Tỉnh Kiên Giang đã hợp nhất vào An Giang, và TP Phú Quốc (cấp huyện) được chuyển thành đặc khu từ 01/07/2025.", "aliases": ["đặc khu", "An Giang"], "answer_type": "free_text", "entities": ["đặc khu Phú Quốc", "An Giang"]}, "obsolete_answer": {"text": "Phú Quốc là thành phố thuộc tỉnh Kiên Giang.", "obsolete_entities": ["thành phố Phú Quốc", "Kiên Giang"]}, "evidence": [{"doc_id": "NQ-1654-2025-UBTVQH15", "article": "1", "clause": "95", "clause_id": "NQ-1654-2025-UBTVQH15#D1.K95", "citation": "NQ 1654/NQ-UBTVQH15, Điều 1, khoản 95", "in_corpus": true}, {"doc_id": "NQ-202-2025-QH15", "article": "1", "clause": "23", "clause_id": "NQ-202-2025-QH15#D1.K23", "citation": "NQ 202/2025/QH15, Điều 1, khoản 23", "in_corpus": true}], "gold_clause_ids": ["NQ-1654-2025-UBTVQH15#D1.K95", "NQ-202-2025-QH15#D1.K23"], "source_url": "", "province_new": "An Giang", "province_is_control": false, "hops": 2, "difficulty": null, "annotator": ["TV3"], "verified": false, "verification_note": "NQ-1654 K95 do TV1 định vị (pilot_80, P-V-C07).", "version": "pilot-0.2", "duplicate_of": "P-T-C06"}
{"id": "P-V-D01", "source_set": "vinh30", "source_id": "D01", "category": "D_before_after", "subtype": null, "item_role": "trap", "question": "Trước và sau ngày 01/07/2025, chính quyền địa phương ở Việt Nam được tổ chức thành mấy cấp?", "reference_date": "2026-11-19", "gold_answer": {"text": "Trước: 3 cấp (tỉnh – huyện – xã). Sau: 2 cấp (tỉnh – xã/phường/đặc khu); cấp huyện bị bãi bỏ.", "aliases": ["3 cấp", "2 cấp", "bãi bỏ cấp huyện"], "answer_type": "free_text", "entities": []}, "obsolete_answer": {"text": "Chính quyền địa phương gồm 3 cấp: tỉnh, huyện, xã (không nêu thay đổi).", "obsolete_entities": ["3 cấp"]}, "evidence": [{"doc_id": "LUAT-72-2025-QH15", "article": "1", "clause": "1", "clause_id": "LUAT-72-2025-QH15#D1.K1", "citation": "Luật 72/2025/QH15, Điều 1, khoản 1", "in_corpus": true}, {"doc_id": "LUAT-72-2025-QH15", "article": "51", "clause": "3", "clause_id": "LUAT-72-2025-QH15#D51.K3", "citation": "Luật 72/2025/QH15, Điều 51, khoản 3", "in_corpus": true}, {"doc_id": "NQ-203-2025-QH15", "article": null, "clause": null, "clause_id": null, "citation": "NQ 203/2025/QH15 (Hiến pháp sửa đổi) — chưa định vị khoản", "in_corpus": false}], "gold_clause_ids": ["LUAT-72-2025-QH15#D1.K1", "LUAT-72-2025-QH15#D51.K3"], "source_url": "", "province_new": null, "province_is_control": null, "hops": null, "difficulty": null, "annotator": ["TV3"], "verified": false, "verification_note": "", "version": "pilot-0.2"}
{"id": "P-V-D02", "source_set": "vinh30", "source_id": "D02", "category": "D_before_after", "subtype": null, "item_role": "trap", "question": "Trước và sau ngày 01/07/2025, tỉnh Bình Thuận thay đổi như thế nào?", "reference_date": "2026-11-19", "gold_answer": {"text": "Trước: là tỉnh riêng, tỉnh lỵ Phan Thiết. Sau: hợp nhất vào tỉnh Lâm Đồng (cùng tỉnh Đắk Nông), không còn là đơn vị hành chính cấp tỉnh.", "aliases": ["hợp nhất vào Lâm Đồng"], "answer_type": "free_text", "entities": []}, "obsolete_answer": {"text": "Bình Thuận không thay đổi, vẫn là tỉnh với tỉnh lỵ Phan Thiết.", "obsolete_entities": ["tỉnh Bình Thuận", "không thay đổi"]}, "evidence": [{"doc_id": "NQ-202-2025-QH15", "article": "1", "clause": "14", "clause_id": "NQ-202-2025-QH15#D1.K14", "citation": "NQ 202/2025/QH15, Điều 1, khoản 14", "in_corpus": true}], "gold_clause_ids": ["NQ-202-2025-QH15#D1.K14"], "source_url": "", "province_new": "Lâm Đồng", "province_is_control": false, "hops": null, "difficulty": null, "annotator": ["TV3"], "verified": false, "verification_note": "", "version": "pilot-0.2"}
{"id": "P-V-D03", "source_set": "vinh30", "source_id": "D03", "category": "D_before_after", "subtype": null, "item_role": "trap", "question": "Trước và sau ngày 01/07/2025, tỉnh Quảng Bình thay đổi như thế nào?", "reference_date": "2026-11-19", "gold_answer": {"text": "Trước: là tỉnh riêng, tỉnh lỵ Đồng Hới. Sau: hợp nhất vào tỉnh Quảng Trị; trung tâm hành chính của tỉnh Quảng Trị mới đặt tại khu vực Đồng Hới cũ.", "aliases": ["hợp nhất vào Quảng Trị", "Đồng Hới"], "answer_type": "free_text", "entities": []}, "obsolete_answer": {"text": "Quảng Bình vẫn là tỉnh riêng, tỉnh lỵ Đồng Hới.", "obsolete_entities": ["tỉnh Quảng Bình"]}, "evidence": [{"doc_id": "NQ-202-2025-QH15", "article": "1", "clause": "9", "clause_id": "NQ-202-2025-QH15#D1.K9", "citation": "NQ 202/2025/QH15, Điều 1, khoản 9", "in_corpus": true}], "gold_clause_ids": ["NQ-202-2025-QH15#D1.K9"], "source_url": "", "province_new": "Quảng Trị", "province_is_control": false, "hops": null, "difficulty": null, "annotator": ["TV3"], "verified": false, "verification_note": "Sheet: Cần dò trung tâm hành chính. Phần 'trung tâm hành chính đặt tại Đồng Hới cũ' chưa có căn cứ trong kho.", "version": "pilot-0.2"}
{"id": "P-V-D04", "source_set": "vinh30", "source_id": "D04", "category": "D_before_after", "subtype": null, "item_role": "trap", "question": "Trung tâm hành chính của tỉnh Lào Cai trước và sau ngày 01/07/2025 đặt ở đâu?", "reference_date": "2026-11-19", "gold_answer": {"text": "Trước: TP Lào Cai. Sau: tỉnh Lào Cai mới (hợp nhất Lào Cai và Yên Bái) đặt trung tâm hành chính tại khu vực TP Yên Bái cũ.", "aliases": ["Yên Bái"], "answer_type": "free_text", "entities": []}, "obsolete_answer": {"text": "Trung tâm hành chính tỉnh Lào Cai đặt tại TP Lào Cai.", "obsolete_entities": ["TP Lào Cai"]}, "evidence": [{"doc_id": "NQ-202-2025-QH15", "article": "1", "clause": "2", "clause_id": "NQ-202-2025-QH15#D1.K2", "citation": "NQ 202/2025/QH15, Điều 1, khoản 2", "in_corpus": true}], "gold_clause_ids": ["TODO_VERIFY_CLAUSE"], "source_url": "", "province_new": "Lào Cai", "province_is_control": false, "hops": null, "difficulty": null, "annotator": ["TV3"], "verified": false, "verification_note": "Sheet: Cần dò trung tâm hành chính. Đáp án cốt lõi là trung tâm hành chính (Yên Bái cũ): không có trong kho; K2 chỉ nêu việc hợp nhất.", "version": "pilot-0.2"}
{"id": "P-V-D05", "source_set": "vinh30", "source_id": "D05", "category": "D_before_after", "subtype": null, "item_role": "trap", "question": "Trung tâm hành chính của tỉnh Bắc Ninh trước và sau ngày 01/07/2025 đặt ở đâu?", "reference_date": "2026-11-19", "gold_answer": {"text": "Trước: TP Bắc Ninh. Sau: tỉnh Bắc Ninh mới (hợp nhất Bắc Ninh và Bắc Giang) đặt trung tâm hành chính tại khu vực TP Bắc Giang cũ.", "aliases": ["Bắc Giang"], "answer_type": "free_text", "entities": []}, "obsolete_answer": {"text": "Trung tâm hành chính tỉnh Bắc Ninh đặt tại TP Bắc Ninh.", "obsolete_entities": ["TP Bắc Ninh"]}, "evidence": [{"doc_id": "NQ-202-2025-QH15", "article": "1", "clause": "5", "clause_id": "NQ-202-2025-QH15#D1.K5", "citation": "NQ 202/2025/QH15, Điều 1, khoản 5", "in_corpus": true}], "gold_clause_ids": ["TODO_VERIFY_CLAUSE"], "source_url": "", "province_new": "Bắc Ninh", "province_is_control": false, "hops": null, "difficulty": null, "annotator": ["TV3"], "verified": false, "verification_note": "Sheet: Cần dò trung tâm hành chính. Đáp án cốt lõi là trung tâm hành chính (Bắc Giang cũ): không có trong kho; K5 chỉ nêu việc hợp nhất.", "version": "pilot-0.2"}
{"id": "P-V-D06", "source_set": "vinh30", "source_id": "D06", "category": "D_before_after", "subtype": null, "item_role": "trap", "question": "Trong đợt sắp xếp ngày 01/07/2025, thành phố Huế có hợp nhất với tỉnh nào không?", "reference_date": "2026-11-19", "gold_answer": {"text": "Không. Huế giữ nguyên ở cấp tỉnh (đã là thành phố trực thuộc trung ương từ 01/01/2025); chỉ cấp huyện bị bỏ và cấp xã được sắp xếp lại.", "aliases": ["không hợp nhất", "giữ nguyên", "trực thuộc trung ương"], "answer_type": "yes_no", "entities": []}, "obsolete_answer": {"text": "Huế là thành phố thuộc tỉnh Thừa Thiên Huế.", "obsolete_entities": ["tỉnh Thừa Thiên Huế"]}, "evidence": [{"doc_id": "NQ-202-2025-QH15", "article": "1", "clause": "24", "clause_id": "NQ-202-2025-QH15#D1.K24", "citation": "NQ 202/2025/QH15, Điều 1, khoản 24", "in_corpus": true}], "gold_clause_ids": ["NQ-202-2025-QH15#D1.K24"], "source_url": "", "province_new": "Huế", "province_is_control": true, "hops": null, "difficulty": null, "annotator": ["TV3"], "verified": false, "verification_note": "K24 liệt kê thành phố Huế trong 11 đơn vị không sắp xếp.", "version": "pilot-0.2"}
{"id": "P-V-D07", "source_set": "vinh30", "source_id": "D07", "category": "D_before_after", "subtype": null, "item_role": "trap", "question": "Trước và sau ngày 01/07/2025, tỉnh Nam Định thay đổi như thế nào?", "reference_date": "2026-11-19", "gold_answer": {"text": "Trước: là tỉnh riêng, tỉnh lỵ TP Nam Định. Sau: hợp nhất vào tỉnh Ninh Bình (cùng tỉnh Hà Nam), không còn là đơn vị hành chính cấp tỉnh.", "aliases": ["hợp nhất vào Ninh Bình"], "answer_type": "free_text", "entities": []}, "obsolete_answer": {"text": "Nam Định vẫn là tỉnh riêng, tỉnh lỵ TP Nam Định.", "obsolete_entities": ["tỉnh Nam Định"]}, "evidence": [{"doc_id": "NQ-202-2025-QH15", "article": "1", "clause": "8", "clause_id": "NQ-202-2025-QH15#D1.K8", "citation": "NQ 202/2025/QH15, Điều 1, khoản 8", "in_corpus": true}], "gold_clause_ids": ["NQ-202-2025-QH15#D1.K8"], "source_url": "", "province_new": "Ninh Bình", "province_is_control": false, "hops": null, "difficulty": null, "annotator": ["TV3"], "verified": false, "verification_note": "", "version": "pilot-0.2"}
