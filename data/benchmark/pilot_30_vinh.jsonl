{"id": "P-V-B03", "source_set": "vinh30", "source_id": "B03", "category": "B_obsolete_trap", "subtype": null, "item_role": "trap", "question": "Thành phố Thủ Đức hiện có bao nhiêu phường?", "reference_date": "2026-11-19", "gold_answer": {"text": "TP Thủ Đức (đơn vị cấp huyện thuộc TP Hồ Chí Minh) đã không còn từ 01/07/2025 do bãi bỏ cấp huyện. Địa bàn cũ được sắp xếp thành các phường mới trực thuộc trực tiếp TP Hồ Chí Minh.", "aliases": ["không còn TP Thủ Đức", "bãi bỏ cấp huyện"], "answer_type": "premise_rejection", "entities": ["Hồ Chí Minh"]}, "obsolete_answer": {"text": "TP Thủ Đức có 34 phường.", "obsolete_entities": ["TP Thủ Đức", "34 phường"]}, "evidence": [{"doc_id": "LUAT-72-2025-QH15", "article": "51", "clause": "3", "clause_id": "LUAT-72-2025-QH15#D51.K3", "citation": "Luật 72/2025/QH15, Điều 51, khoản 3", "in_corpus": true}, {"doc_id": "LUAT-72-2025-QH15", "article": "1", "clause": "1", "clause_id": "LUAT-72-2025-QH15#D1.K1", "citation": "Luật 72/2025/QH15, Điều 1, khoản 1", "in_corpus": true}, {"doc_id": "NQ-1685-2025-UBTVQH15", "article": "1", "clause": "68", "clause_id": "NQ-1685-2025-UBTVQH15#D1.K68", "citation": "NQ 1685/NQ-UBTVQH15, Điều 1, khoản 68", "in_corpus": true}, {"doc_id": "NQ-203-2025-QH15", "article": null, "clause": null, "clause_id": null, "citation": "NQ 203/2025/QH15 (Hiến pháp sửa đổi) — chưa định vị khoản", "in_corpus": false}], "gold_clause_ids": ["LUAT-72-2025-QH15#D51.K3", "LUAT-72-2025-QH15#D1.K1"], "source_url": "", "province_new": "Hồ Chí Minh", "province_is_control": false, "hops": null, "difficulty": null, "annotator": ["TV3"], "verified": false, "verification_note": "D51.K3 định nghĩa cấp huyện gồm cả 'thành phố thuộc thành phố trực thuộc Trung ương'.", "version": "pilot-0.2"}
