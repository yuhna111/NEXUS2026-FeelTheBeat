# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# vLLM OpenAI-compatible server for open models
VLLM_BASE_URL=http://localhost:8000/v1

QDRANT_URL=http://localhost:6333
# No Docker? Uncomment to use embedded Qdrant stored in this folder (QDRANT_URL is then ignored).
# QDRANT_PATH=qdrant_storage/local
LLM_CACHE_DIR=.llm_cache
